#SPIRAL MATRIX
class Solution {
    public List<Integer> spiralOrder(int[][] matrix) {
        // Get matrix dimensions
        int rows = matrix.length;
        int cols = matrix[0].length;
      
        // Direction vectors: right(0,1), down(1,0), left(0,-1), up(-1,0)
        // Stored as: [rowDelta1, colDelta1, rowDelta2, colDelta2, ...]
        int[] directions = {0, 1, 0, -1, 0};
      
        // Current position and direction index
        int currentRow = 0;
        int currentCol = 0;
        int directionIndex = 0; // 0=right, 1=down, 2=left, 3=up
      
        // Result list to store spiral order elements
        List<Integer> result = new ArrayList<>();
      
        // Track visited cells to know when to turn
        boolean[][] visited = new boolean[rows][cols];
      
        // Traverse all cells in the matrix
        int totalCells = rows * cols;
        for (int count = 0; count < totalCells; count++) {
            // Add current cell value to result
            result.add(matrix[currentRow][currentCol]);
          
            // Mark current cell as visited
            visited[currentRow][currentCol] = true;
          
            // Calculate next position based on current direction
            int nextRow = currentRow + directions[directionIndex];
            int nextCol = currentCol + directions[directionIndex + 1];
          
            // Check if we need to change direction (hit boundary or visited cell)
            if (nextRow < 0 || nextRow >= rows || 
                nextCol < 0 || nextCol >= cols || 
                visited[nextRow][nextCol]) {
                // Turn clockwise to next direction
                directionIndex = (directionIndex + 1) % 4;
            }
          
            // Move to next position using current direction
            currentRow += directions[directionIndex];
            currentCol += directions[directionIndex + 1];
        }
      
        return result;
    }
}
#LENGTH OF LAST WORD
class Solution {
    public int lengthOfLastWord(String s) {
        // Start from the end of the string
        int endIndex = s.length() - 1;
      
        // Skip trailing spaces from the end
        while (endIndex >= 0 && s.charAt(endIndex) == ' ') {
            endIndex--;
        }
      
        // Mark the end position of the last word
        int startIndex = endIndex;
      
        // Move backwards to find the start of the last word
        // Stop when we encounter a space or reach the beginning
        while (startIndex >= 0 && s.charAt(startIndex) != ' ') {
            startIndex--;
        }
      
        // Calculate the length of the last word
        // startIndex points to the space before the word (or -1 if at beginning)
        // endIndex points to the last character of the word
        return endIndex - startIndex;
    }
}

#125 Valid Palindrome
class Solution {
    /**
     * Determines if a string is a palindrome, considering only alphanumeric characters
     * and ignoring cases.
     *
     * @param s the input string to check
     * @return true if the string is a palindrome, false otherwise
     */
    public boolean isPalindrome(String s) {
        // Initialize two pointers: left pointer starts at beginning, right pointer at end
        int left = 0;
        int right = s.length() - 1;

        // Continue comparing characters while pointers haven't crossed
        while (left < right) {
            // Get characters at current positions
            char leftChar = s.charAt(left);
            char rightChar = s.charAt(right);

            // Skip non-alphanumeric character on the left
            if (!Character.isLetterOrDigit(leftChar)) {
                left++;
            }
            // Skip non-alphanumeric character on the right
            else if (!Character.isLetterOrDigit(rightChar)) {
                right--;
            }
            // Compare characters (case-insensitive)
            else if (Character.toLowerCase(leftChar) != Character.toLowerCase(rightChar)) {
                // Characters don't match - not a palindrome
                return false;
            }
            else {
                // Characters match - move both pointers inward
                left++;
                right--;
            }
        }

        // All alphanumeric characters matched - string is a palindrome
        return true;
    }
}

#136 Single Number
class Solution {
    /**
     * Finds the single number in an array where every element appears twice except for one.
     * Uses XOR operation property: a ^ a = 0 and a ^ 0 = a
     *
     * @param nums Array of integers where each element appears twice except one
     * @return The single number that appears only once
     */
    public int singleNumber(int[] nums) {
        // Initialize result variable to store XOR of all elements
        int result = 0;

        // Iterate through each number in the array
        for (int number : nums) {
            // XOR current number with accumulated result
            // Duplicate numbers will cancel out (n ^ n = 0)
            // The single number will remain (0 ^ n = n)
            result ^= number;
        }

        // Return the single number that appears only once
        return result;
    }
}

#1114 Print in Order
class Foo {
    // Semaphore for controlling execution of first() method
    // Initialized with 1 permit to allow first() to run immediately
    private Semaphore firstSemaphore = new Semaphore(1);
  
    // Semaphore for controlling execution of second() method
    // Initialized with 0 permits to block second() until first() completes
    private Semaphore secondSemaphore = new Semaphore(0);
  
    // Semaphore for controlling execution of third() method
    // Initialized with 0 permits to block third() until second() completes
    private Semaphore thirdSemaphore = new Semaphore(0);

    /**
     * Constructor for Foo class
     */
    public Foo() {
        // Empty constructor - semaphores are initialized at declaration
    }

    /**
     * Executes the first print operation
     * This method will run first regardless of thread execution order
     * 
     * @param printFirst Runnable that prints "first"
     * @throws InterruptedException if thread is interrupted while waiting
     */
    public void first(Runnable printFirst) throws InterruptedException {
        // Acquire permit from firstSemaphore (will succeed immediately on first call)
        firstSemaphore.acquire();
      
        // printFirst.run() outputs "first". Do not change or remove this line.
        printFirst.run();
      
        // Release permit for secondSemaphore, allowing second() to proceed
        secondSemaphore.release();
    }

    /**
     * Executes the second print operation
     * This method will only run after first() has completed
     * 
     * @param printSecond Runnable that prints "second"
     * @throws InterruptedException if thread is interrupted while waiting
     */
    public void second(Runnable printSecond) throws InterruptedException {
        // Acquire permit from secondSemaphore (blocks until first() releases it)
        secondSemaphore.acquire();
      
        // printSecond.run() outputs "second". Do not change or remove this line.
        printSecond.run();
      
        // Release permit for thirdSemaphore, allowing third() to proceed
        thirdSemaphore.release();
    }

    /**
     * Executes the third print operation
     * This method will only run after second() has completed
     * 
     * @param printThird Runnable that prints "third"
     * @throws InterruptedException if thread is interrupted while waiting
     */
    public void third(Runnable printThird) throws InterruptedException {
        // Acquire permit from thirdSemaphore (blocks until second() releases it)
        thirdSemaphore.acquire();
      
        // printThird.run() outputs "third". Do not change or remove this line.
        printThird.run();
      
        // Release permit for firstSemaphore, resetting for potential reuse
        firstSemaphore.release();
    }
}
